rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['title', 'category', 'time', 'isCompleted', 'createdAt', 'completedAt'])
        && request.resource.data.keys().hasAll(['title', 'category', 'time', 'isCompleted', 'createdAt', 'completedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.category in ['Học tập', 'Cuộc sống']
        && request.resource.data.time is string
        && request.resource.data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && request.resource.data.isCompleted is bool
        && request.resource.data.createdAt is int
        && (request.resource.data.completedAt == null || request.resource.data.completedAt is int);
    }
    match /users/{uid}/devices/{deviceId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt is int;
    }
  }
}
